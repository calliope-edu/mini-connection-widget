{
  "name": "@calliope-edu/mini-connection-widget",
  "version": "0.2.1",
  "description": "High-level Calliope mini connection orchestration on top of @microbit/microbit-connection — simultaneous USB+BLE tracking, smart picker recovery, stale-bond detection, automatic flash routing, and a framework-agnostic store, plus Svelte UI components built on @calliope-edu/ui.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.11.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/calliope-edu/mini-connection-widget.git"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./makecode": {
      "types": "./src/makecode/index.ts",
      "import": "./src/makecode/index.ts"
    }
  },
  "files": [
    "src",
    "patches"
  ],
  "scripts": {
    "test": "node --experimental-transform-types --import ./test/register-hooks.mjs --test test/*.test.ts scripts/*.test.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings"
  },
  "peerDependencies": {
    "@calliope-edu/ui": ">=0.1.0 <1.0.0",
    "@microbit/makecode-embed": "*",
    "@microbit/microbit-connection": "1.0.0-beta.1",
    "svelte": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "svelte": { "optional": true },
    "@calliope-edu/ui": { "optional": true },
    "@microbit/makecode-embed": { "optional": true }
  },
  "devDependencies": {
    "@calliope-edu/ui": "github:calliope-edu/calliope-ui#v0.1.0",
    "@capacitor-community/bluetooth-le": "^7.3.0",
    "@capacitor/core": "^7.4.4",
    "@capacitor/filesystem": "^7.1.6",
    "@microbit/capacitor-community-nordic-dfu": "v7.0.0-microbit.4",
    "@microbit/microbit-connection": "1.0.0-beta.1",
    "svelte": "^5.41.0",
    "svelte-check": "^4.7.7",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "pnpm": {
    "patchedDependencies": {
      "@microbit/microbit-connection@1.0.0-beta.1": "patches/@microbit__microbit-connection@1.0.0-beta.1.patch"
    }
  },
  "dependencies": {
    "@types/w3c-web-usb": "^1.0.14",
    "@types/web-bluetooth": "^0.0.21",
    "nrf-intel-hex": "^1.4.0"
  }
}
